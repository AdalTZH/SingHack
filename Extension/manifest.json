{
  "manifest_version": 3,
  "name": "SingPass Insurance Chat",
  "version": "1.0.0",
  "description": "Insurance agent chat with document upload support",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:9000/*",
    "http://localhost:8007/*",
    "http://localhost:8004/*",
    "http://127.0.0.1:8004/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["cursor-textbox.css"],
      "run_at": "document_idle"
    }
  ]
}

